# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local JSON data store (dev persistence for the admin dashboard)
/.data

# admin-uploaded media (keep the folder, ignore its contents)
/public/uploads/*
!/public/uploads/.gitkeep

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local content store (may contain customer orders)
/.data/

# admin uploads
/public/uploads/*
!/public/uploads/.gitkeep
